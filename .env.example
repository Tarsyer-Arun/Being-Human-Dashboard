# ── Being Human Dashboard — Environment Variables ────────────────────────────
# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Flask session signing key.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# MongoDB connection URI.
# URL-encode special characters in the password: # = %23, ! = %21, $ = %24
MONGO_URI=mongodb://username:password@host:27018/beinghumanServer?authSource=admin

# Database used by the dashboard
DB_NAME=beinghumanServer

# Set to 'production' on the server — enables the Secure flag on session cookies
FLASK_ENV=production

# Session lifetime in hours (default 8)
SESSION_HOURS=8

# Bind address and port for run.py (production uses gunicorn instead)
HOST=127.0.0.1
PORT=21582

# Never enable on a server: the Werkzeug debugger allows remote code execution
FLASK_DEBUG=0

# ── Device heartbeat DB (devices_summary) — READ-ONLY ────────────────────────
# Powers the NVR / Device Status monitoring tab. Same server ROK's dashboard
# reads from. The dashboard must never write to this database.
DS_HOST=host
DS_PORT=27018
DS_USER=username
DS_PASS=password
DS_NAME=devices_summary
